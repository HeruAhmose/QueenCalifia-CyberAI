    },
    {
      "path": "sovereignty/approvals.py",
      "store": "sovereignty-approvals-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "postgresql_capable": true,
      "production_cutover_complete": false,
      "environment": ["QC_APPROVALS_DB", "QC_DB_PATH", "QC_DATABASE_URL", "DATABASE_URL"],
