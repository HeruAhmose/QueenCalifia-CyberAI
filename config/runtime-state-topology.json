      "note": "Production composition requires PostgreSQL live-scanner tables. Legacy scans/baselines/findings_log have a fail-closed preservation path but remain a cutover blocker until production disposition is executed."
    },
    {
      "path": "sovereignty/audit_chain.py",
      "store": "sovereignty-audit-chain-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
