    "migration_tool": "scripts/migrate_primary_sqlite_to_postgres.py",
    "postgresql_capable": true,
    "production_cutover_complete": false
  },
  "runtime_state_migration_contract": {
    "migration_tool": "scripts/migrate_runtime_state_to_postgres.py",
    "restore_verification": "scripts/migrate_runtime_state_to_postgres.py --verify-manifest-stdin < runtime-state-migration-manifest.json",
    "source_authorities": [
      "primary-runtime-db",
      "sovereignty-audit-chain-db",
      "sovereignty-approvals-db",
      "incident-response-db",
      "auto-remediation-db",
      "evolution-db",
      "threat-intelligence-db"
    ],
    "unresolved_writer_blockers": [
      "vulnerability-scan-job-db",
      "live-scanner-db"
    ],
    "verification": [
      "read-only SQLite source inventory",
      "source semantic invariants",
      "empty PostgreSQL target authority",
      "transactional copy",
      "serial sequence reset",
      "row-count verification",
      "deterministic table content SHA-256",
      "manifest-based PostgreSQL restore verification"
    ],
    "postgresql_capable": true,
    "production_cutover_complete": false,
    "note": "The orchestrator can stage and verify recognized authoritative SQLite state in PostgreSQL. Historical vulnerability/live-scanner SQLite remains an explicit cutover blocker until production data disposition is evidenced."
  },
  "scanner_externalization_contract": {
    "module": "engines/externalized_scanners.py",
    "production_composition": "app.py",
    "worker_composition": "tasks.py",
    "vulnerability_job_authority": "celery-redis",
    "live_scanner_authority": "postgresql",
    "live_scanner_tables": ["qc_live_scans", "qc_live_baselines", "qc_live_findings"],
    "postgresql_capable": true,
    "production_cutover_complete": false,
    "note": "Production composition refuses non-Celery vulnerability scan jobs and non-PostgreSQL live-scanner state. Original SQLite implementations remain local/dev fallback. Historical SQLite rows must still be dispositioned before cutover."
  },
  "gateway_artifact_contract": {
    "module": "core/externalized_artifacts.py",
    "auth_integration": "core/auth.py",
    "production_composition": "app.py",
    "api_key_authority": "postgresql:qc_api_keys",
    "request_audit_authority": "postgresql:qc_request_audit",
    "api_key_cross_replica_revocation": true,
    "request_audit_global_chain_lock": true,
    "postgresql_capable": true,
    "production_cutover_complete": false,
    "note": "PostgreSQL mode removes mutable API-key JSON and request-audit JSONL as production authorities. Production deployment cutover and historical artifact disposition remain unverified."
  },
  "postgresql_backup_restore_contract": {
    "ci_script": "scripts/ci/verify_postgres_backup_restore.sh",
    "postgresql_major": 16,
    "backup_format": "pg_dump custom",
    "restore_target": "separate PostgreSQL database",
    "post_restore_verification": "runtime-state manifest row counts plus SHA-256 digests",
    "ci_contract_verified": true,
    "production_backup_restore_tested": false,
    "note": "Protected CI has executed PostgreSQL 16 pg_dump custom-format backup, restore into a separate database, and manifest count/digest verification. This is not production-data backup/restore evidence."
  },
  "historical_state_disposition_contract": {
    "tool": "scripts/disposition_legacy_runtime_state.py",
    "stdin_sources": [
      "QC_API_KEYS_FILE",
      "QC_AUDIT_LOG_FILE",
      "QC_SPKI_LOG_FILE"
    ],
    "fixed_sqlite_staging": {
      "vulnerability-scan-job-db": ".cutover-staging/qc-vulnerability-legacy.db",
      "live-scanner-db": ".cutover-staging/qc-live-scanner-legacy.db"
    },
    "staging_constraints": [
      "repository-local git-ignored directory",
      "non-symlink regular files only",
      "read-only SQLite connection"
    ],
    "targets": {
      "vulnerability-scan-job-db": "postgresql:qc_legacy_vuln_scan_jobs",
      "live-scanner-db": [
        "postgresql:qc_live_scans",
        "postgresql:qc_live_baselines",
        "postgresql:qc_live_findings"
      ],
      "QC_API_KEYS_FILE": "postgresql:qc_api_keys",
      "QC_AUDIT_LOG_FILE": "postgresql:qc_request_audit",
      "QC_SPKI_LOG_FILE": "postgresql:qc_spki_evidence"
    },
    "verification": [
      "fixed repository-local SQLite staging",
      "stdin-only file artifact ingestion",
      "empty target authority requirement",
      "audit hash/HMAC chain validation",
      "row-count verification",
      "deterministic SHA-256 content verification"
    ],
    "ci_contract_verified": false,
    "production_disposition_complete": false,
    "note": "The repository has a fail-closed preservation path for all remaining historical scanner and file evidence. Production sources must still be captured and the resulting evidence recorded before any PVC/file binding is removed."
  },
  "security_engine_database_contract": {
    "runtime_adapter_module": "engines/runtime_state.py",
    "production_composition": "app.py",
    "postgresql_environment": ["QC_DATABASE_URL", "DATABASE_URL"],
    "postgresql_capable": true,
    "production_cutover_complete": false,
    "note": "Incident response, remediation, evolution, and threat-intelligence runtime composition can use PostgreSQL with replica-aware mutation controls. Historical state has a verified staging migration path, but production execution, restore evidence, rolling validation, remaining writable-path removal, and explicit cutover are still required before HA."
  },
  "sqlite_connectors": [
    {
      "path": "core/database.py",
      "store": "primary-runtime-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "environment": ["QC_DB_PATH", "QC_DATABASE_URL", "DATABASE_URL"],
      "note": "The primary database contract can target PostgreSQL, but SQLite remains an allowed runtime backend until production cutover, data verification, rollback, backup/restore, and rolling-update gates are completed."
    },
    {
      "path": "engines/vulnerability_engine.py",
      "runtime_adapter": "engines/externalized_scanners.py:CeleryVulnerabilityEngine",
      "store": "vulnerability-scan-job-db",
      "scope": "api-worker",
      "authoritative": false,
      "migration_required": true,
      "production_writer_disabled": true,
      "historical_disposition_target": "qc_legacy_vuln_scan_jobs",
      "environment": ["QC_DB_PATH", "QC_USE_CELERY", "QC_REDIS_URL"],
      "note": "Production composition requires Celery/Redis and does not initialize qc_vuln_scan_jobs. Historical rows have a fail-closed PostgreSQL preservation path but remain a cutover blocker until production disposition is executed."
    },
    {
      "path": "engines/incident_response.py",
      "runtime_adapter": "engines/runtime_state.py:PostgresIncidentResponseOrchestrator",
      "store": "incident-response-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "postgresql_capable": true,
      "production_cutover_complete": false,
      "environment": ["QC_DB_PATH", "QC_DATABASE_URL", "DATABASE_URL"],
      "note": "PostgreSQL mode refreshes DB authority and serializes per-incident mutations across replicas; historical SQLite incidents can be staged with attack-chain identity materialized and verified, but production cutover remains incomplete."
    },
    {
      "path": "engines/auto_remediation.py",
      "runtime_adapter": "engines/runtime_state.py:PostgresAutoRemediation",
      "store": "auto-remediation-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "postgresql_capable": true,
      "production_cutover_complete": false,
      "environment": ["QC_DB_PATH", "QC_DATABASE_URL", "DATABASE_URL"],
      "note": "PostgreSQL mode claims each plan under an advisory lock before execution so replicas cannot execute the same remediation plan concurrently; historical plan/action state has a verified staging migration path."
    },
    {
      "path": "engines/evolution_engine.py",
      "runtime_adapter": "engines/runtime_state.py:PostgresEvolutionEngine",
      "store": "evolution-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "postgresql_capable": true,
      "production_cutover_complete": false,
      "environment": ["QC_EVOLUTION_DB", "QC_DATABASE_URL", "DATABASE_URL"],
      "note": "PostgreSQL mode provides exactly-once completed-scan learning. SQLite memory snapshots are not considered PostgreSQL backups; the pg_dump/restore contract is the external backup path."
    },
    {
      "path": "engines/threat_intel_auto.py",
      "runtime_adapter": "engines/runtime_state.py:PostgresThreatIntelEngine",
      "store": "threat-intelligence-db",
      "scope": "api",
      "authoritative": true,
      "migration_required": true,
      "postgresql_capable": true,
      "production_cutover_complete": false,
      "environment": ["QC_THREAT_INTEL_DB", "QC_EVOLUTION_DB", "QC_DATABASE_URL", "DATABASE_URL"],
      "note": "PostgreSQL mode serializes scheduler lease acquisition and per-indicator merge updates across replicas; production cutover and restore evidence remain incomplete."
    },
    {
      "path": "engines/live_scanner.py",
      "runtime_adapter": "engines/externalized_scanners.py:PostgresLiveScanner",
      "store": "live-scanner-db",
      "scope": "api",
      "authoritative": false,
      "migration_required": true,
      "postgresql_capable": true,
      "production_writer_disabled": true,
      "historical_disposition_targets": ["qc_live_scans", "qc_live_baselines", "qc_live_findings"],
